# hns 훅 설정. 프로젝트의 .claude/hns-hooks.env 로 복사해서 채운다. 환경변수가 있으면 그것이 우선.
# reminder : SessionStart 복구 + PreCompact 보존 지시만 (검사 없음)
# feedback : + 커밋 전 컴파일(비차단 알림) + 편집 후 린트(알림)
# enforce  : + 컴파일 실패 시 커밋 차단 + Stop 증거 게이트 (settings 의 Stop 항목을 유지)
HNS_HOOK_TIER=feedback

# 커밋 전에 돌릴 컴파일 명령. 비우면 커밋 게이트 없음.
HNS_COMPILE_CMD="./gradlew compileKotlin compileTestKotlin -q"

# 바뀐 파일 하나를 린트하는 명령. {file} 자리표시자. 비우면 린트 없음.
HNS_LINT_CMD=""
# 린트 대상 basename 패턴 (공백 구분)
HNS_LINT_GLOB="*.kt *.ts *.tsx"

# 레포 밖 지식베이스(Obsidian LLM Wiki 볼트 루트, wiki/index.md 가 있는 곳). 비우면 hns:kb 비활성.
# 홈은 ~ 로 쓴다(공개 레포에 사용자명이 남지 않게). 프로젝트당 볼트 하나 — 개인 레포는 개인 볼트만.
HNS_KB_PATH=""
